# Скопируйте в .env и заполните. .env в git не попадает.
# Менеджер, под которым тесты создают заявки (код-пароль по умолчанию 2222 — *_MANAGER_PIN)
KZ_MANAGER_LOGIN=
KZ_MANAGER_PASSWORD=
UZ_MANAGER_LOGIN=
UZ_MANAGER_PASSWORD=

